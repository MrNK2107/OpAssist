# Supabase (database only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Firebase Admin SDK credentials (from service account JSON - get from Firebase Console > Project Settings > Service accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
# Paste the service account's "private_key" value here (one line, quoted, newlines written as backslash-n)
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# AI Providers
GROQ_API_KEY=your-groq-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# API Keys for Scrapers
GITHUB_TOKEN=your-github-personal-access-token
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key

# Scraper Settings
SCRAPE_INTERVAL_HOURS=6
MIN_SALARY=0

# Server
HOST=0.0.0.0
PORT=8000

# Dev Auth (set to true ONLY for local development without Supabase)
# Mock user when Firebase is not configured. Refused when ENV=production.
ALLOW_DEV_AUTH=false
ENV=development
